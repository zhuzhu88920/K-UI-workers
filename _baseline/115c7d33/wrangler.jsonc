{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kui-v2",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-15",
  "workers_dev": true,
  "vars": {
    // 仓库不预置任何管理员凭据。首次打开面板会进入「初始化管理员」页面，
    // 由部署者自建用户名与密码（≥12 位，PBKDF2 哈希后存入 D1 的 admin_credentials 表）。
    // 如需用环境变量接管（放弃面板内自建），可在此填 ADMIN_USERNAME 并执行
    // `npx wrangler secret put ADMIN_PASSWORD`，此时面板会视为已初始化。
    //
    // PAGES_ORIGIN 是 realtime 的 WebSocket Origin 白名单（逗号分隔，可多域名）。
    // 未配置时只放行 *.pages.dev 与 *.workers.dev —— 绑定自定义域名的部署
    // 会导致 /dashboard/ws 握手 403、实时推送永久重连。绑了域名就必须填这里。
    "PAGES_ORIGIN": "https://kui.zhuyongfu.cn",
    "PROXY_USER": "kui",
    "PROXY_PASS": "kui"
  },
  "assets": {
    "directory": "static",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*", "/health", "/agent/ws", "/dashboard/*", "/public/*", "/notify", "/public-policy", "/frequency-policy"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kui-v2-db",
      "database_id": "2902d37f-7fc6-431d-9217-2e20cea51e1a",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "VPS_PRESENCE", "class_name": "VpsPresence" },
      { "name": "DASHBOARD_HUB", "class_name": "DashboardHub" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VpsPresence", "DashboardHub"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
