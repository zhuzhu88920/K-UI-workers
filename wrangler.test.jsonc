{
  // ============================================================
  //  测试环境配置 —— 与生产 kui-v2 完全隔离
  //  用途：多对多用户-节点授权改造的验证环境
  //  警告：此配置下的 D1 是独立数据库，不含任何生产数据
  // ============================================================
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kui-test",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-15",
  "workers_dev": true,
  "vars": {
    // 测试环境不预置凭据，首次打开面板走「初始化管理员」流程。
    // PAGES_ORIGIN 必须包含测试域名，否则 realtime WebSocket 握手会403。
    "PAGES_ORIGIN": "https://kui-test.zhuyongfu.cn",
    "PROXY_USER": "kui",
    "PROXY_PASS": "kui"
  },
  "assets": {
    "directory": "static",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*", "/health", "/agent/ws", "/dashboard/*", "/public/*", "/notify", "/public-policy", "/frequency-policy"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kui-test-db",
      "database_id": "ee9b5fe5-9023-4720-b2f5-bd2c3db12937",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // 测试环境不需要 cron，避免无意义调用与告警噪声
    "crons": []
  },
  "durable_objects": {
    "bindings": [
      { "name": "VPS_PRESENCE", "class_name": "VpsPresence" },
      { "name": "DASHBOARD_HUB", "class_name": "DashboardHub" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VpsPresence", "DashboardHub"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
